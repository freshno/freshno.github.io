---
import Base from '../layouts/Base.astro';
---

<Base title="页面不存在" description="没有这个页面。">
  <section class="wrap center-page">
    <div>
      <div class="big">404</div>
      <p class="muted" style="margin-top:16px">这个地址没有东西。可能是链接过期了，也可能是我改了文件名。</p>
      <p style="margin-top:24px"><a class="btn" href="/">回到首页</a></p>
    </div>
  </section>
</Base>
