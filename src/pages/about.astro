---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import * as C from '../consts';
import avatar from '../assets/images/avatar.png';

// 「关于」的文字内容可以从 Obsidian 的 关于.md 同步过来；
// 版式（左边头像 + 右边文字）固定在这里。
const entry = await getEntry('pages', 'about');
const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content ?? null;
const d = entry?.data ?? {};

const doing = d.doing || '（待填写）';
const located = d.located || '（待填写）';
const email = d.email || C.EMAIL;
const title = d.title || '关于';
---

<Base title={title} description={`关于 ${C.SITE_NAME}，以及它怎么被做出来的。`}>
  <section class="wrap page-head">
    <h1>{title}</h1>
  </section>

  <section class="wrap">
    <div class="about-grid">
      <aside class="about-aside">
        <div class="portrait">
          <Image src={avatar} alt={`${C.SITE_NAME} 的头像`} widths={[300, 600]} loading="eager" />
        </div>
        <div class="kv">
          <div class="row"><span class="k">在做</span><span class="v">{doing}</span></div>
          <div class="row"><span class="k">所在</span><span class="v">{located}</span></div>
          <div class="row">
            <span class="k">邮箱</span>
            <span class="v"><a class="link" href={`mailto:${email}`}>{email}</a></span>
          </div>
        </div>
      </aside>

      <div class="prose">
        {
          Content ? (
            <Content />
          ) : (
            <p>
              还没写。在 Obsidian 的 <code>发布留存/网站发布/关于.md</code> 里写完，同步一下就有了。
            </p>
          )
        }
      </div>
    </div>
  </section>
</Base>
